# Copy to .env and fill during the M0 account batch (see SETUP-ACCOUNTS.md).

# Supabase Session-pooler connection string (step 4.3)
DATABASE_URL=

# Resend API key (step 6.5)
RESEND_API_KEY=

# Sender address for all product email (step 6.6)
EMAIL_FROM=Nakodo <hello@nakodo.dev>

# Public URL of the deployed site/API (step 5.3)
APP_URL=https://nakodo.dev

# M9d tier 2 — Telegram notifications (optional channel; unset = feature off).
# Bot created via @BotFather (SETUP-ACCOUNTS.md §8); all three also go in Vercel env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Any long random string; scripts/telegram-setup.ts registers it with setWebhook
# and the webhook route rejects deliveries that don't echo it.
TELEGRAM_WEBHOOK_SECRET=
